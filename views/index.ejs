<%-include("layout/header")%>

<div class="px-4 py-5 my-5 text-center">
  <h1 class="display-4 fw-bold">Welcome to AuthApp</h1>
  <div class="col-lg-6 mx-auto">
    <p class="lead mb-4">
      A secure authentication demo with Google OAuth 2.0 and local login.
    </p>
    <% if (typeof user !== 'undefined' && user) { %>
      <p class="mb-4">You are logged in as <strong><%= user.username %></strong>.</p>
      <div class="d-flex justify-content-center gap-3">
        <a href="/profile" class="btn btn-primary btn-lg">View Profile</a>
        <a href="/logout" class="btn btn-outline-secondary btn-lg">Logout</a>
      </div>
    <% } else { %>
      <div class="d-flex justify-content-center gap-3">
        <a href="/login" class="btn btn-primary btn-lg">Login</a>
        <a href="/register" class="btn btn-outline-primary btn-lg">Register</a>
      </div>
    <% } %>
  </div>
</div>

<%-include("layout/footer")%>
