<%-include("layout/header")%>

<div class="max-w-lg mx-auto mt-10 sm:mt-16 px-4">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
    <% if (user.avatar) { %>
      <img src="<%= user.avatar %>" alt="Avatar" class="w-24 h-24 rounded-full mx-auto mb-4" />
    <% } else { %>
      <div class="w-24 h-24 rounded-full bg-indigo-600 text-white flex items-center justify-center mx-auto mb-4 text-3xl font-bold"><%= user.username.charAt(0).toUpperCase() %></div>
    <% } %>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Welcome, <%= user.username %></h1>
    <% if (user.email) { %>
      <p class="text-gray-500 mb-1"><%= user.email %></p>
    <% } %>
    <p class="text-gray-400 text-sm mb-4">Account created: <%= new Date(user.createdAt).toLocaleDateString() %></p>
    <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= user.googleId ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-700' %>"><%= user.googleId ? 'Google' : 'Local' %></span>
    <div class="mt-6">
      <a href="/logout" class="inline-block bg-white text-red-600 px-6 py-2 rounded-lg font-medium border border-red-300 hover:bg-red-50 transition-colors">Logout</a>
    </div>
  </div>
</div>

<%-include("layout/footer")%>
