<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>AuthApp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔐</text></svg>" />
    <script>
(function(){function n(t,e){e=e||{};fetch(t,{method:e.method||"GET",body:e.body||null,headers:e.headers||{}}).then(function(r){r.text().then(function(h){var d=new DOMParser().parseFromString(h,"text/html");document.title=d.title;document.body.innerHTML=d.body.innerHTML;window.history.pushState({},"",r.url)})}).catch(function(){window.location.href=t})}document.addEventListener("click",function(e){var t=e.target.closest("a[href]");if(!t)return;try{var r=new URL(t.href);if(r.origin!==location.origin)return;if(t.hasAttribute("download")||t.target==="_blank")return;if(e.ctrlKey||e.metaKey||e.shiftKey)return;if(r.pathname.startsWith("/auth/google"))return;e.preventDefault();n(r.pathname+r.search)}catch(u){}});document.addEventListener("submit",function(e){var t=e.target;e.preventDefault();var r=new URL(t.action||window.location.href);var u=(t.method||"GET").toUpperCase();var o=null;var i={};if(u==="POST"){o=new URLSearchParams(new FormData(t));i["Content-Type"]="application/x-www-form-urlencoded"}n(r.pathname+r.search,{method:u,body:o,headers:i})});window.addEventListener("popstate",function(){var e=window.location.pathname+window.location.search;fetch(e).then(function(t){return t.text()}).then(function(t){var r=new DOMParser().parseFromString(t,"text/html");document.title=r.title;document.body.innerHTML=r.body.innerHTML})})})();
</script>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <a href="/" class="text-xl font-bold text-gray-900 tracking-tight">AuthApp</a>
          <div class="flex items-center space-x-1">
            <a href="/" class="<%= path === '/' ? 'text-indigo-600 font-semibold bg-indigo-50' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %> px-3 py-2 text-sm font-medium rounded-lg transition-colors">Home</a>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/profile" class="<%= path === '/profile' ? 'text-indigo-600 font-semibold bg-indigo-50' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %> px-3 py-2 text-sm font-medium rounded-lg transition-colors">Profile</a>
              <a href="/logout" class="text-gray-600 hover:text-gray-900 hover:bg-gray-50 px-3 py-2 text-sm font-medium rounded-lg transition-colors">Logout</a>
            <% } else { %>
              <a href="/login" class="<%= path === '/login' ? 'text-indigo-600 font-semibold bg-indigo-50' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %> px-3 py-2 text-sm font-medium rounded-lg transition-colors">Login</a>
              <a href="/register" class="<%= path === '/register' ? 'text-indigo-600 font-semibold bg-indigo-50' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50' %> px-3 py-2 text-sm font-medium rounded-lg transition-colors">Register</a>
            <% } %>
          </div>
        </div>
      </div>
    </nav>

    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
      <% success_msg.forEach(function(msg) { %>
        <div class="max-w-5xl mx-auto mt-4 px-4 sm:px-6 lg:px-8">
          <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span class="text-sm font-medium"><%= msg %></span>
            <button onclick="this.parentElement.remove()" class="text-green-500 hover:text-green-700 ml-4 text-lg leading-none">&times;</button>
          </div>
        </div>
      <% }); %>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
      <% error_msg.forEach(function(msg) { %>
        <div class="max-w-5xl mx-auto mt-4 px-4 sm:px-6 lg:px-8">
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span class="text-sm font-medium"><%= msg %></span>
            <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 ml-4 text-lg leading-none">&times;</button>
          </div>
        </div>
      <% }); %>
    <% } %>

    <main class="flex-1">
